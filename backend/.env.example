# Backend Environment Variables
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Clerk Authentication (Get these from https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_placeholder_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_publishable_key

# Supabase PostgreSQL (Get these from https://supabase.com/dashboard)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_service_role_key

# Stripe Payment Gateway (Get these from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_placeholder_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret

# SMTP Email (Optional, falls back to console logging in development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Uber Clone Support <support@uberclone.com>"
